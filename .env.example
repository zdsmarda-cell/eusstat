# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Port pro webový a API server (např. 3030 nebo 3000)
APP_PORT=3030

# SSL / HTTPS certifikáty pro přímý běh na https:// (např. https://eusstat.impossible.cz:3030)
SSL_KEY_PATH="/etc/apache2/ssl/impossible_cz.key"
SSL_CERT_PATH="/etc/apache2/ssl/impossible_cz.crt"
# SSL_CA_PATH="/etc/apache2/ssl/ca_bundle.crt"

# Konfigurace připojení k MariaDB / MySQL databázi
DB_HOST="db.mobilgroup.cz"
DB_PORT=3306
PORT=3306
DB_USER="fhb_crm"
DB_PASSWORD="your_database_password_here"
DB_NAME="fhb_crm"
DB_SSL=false

# Alternativní názvy (kompatibilita)
# MARIADB_HOST="db.mobilgroup.cz"
# MARIADB_PORT=3306
# MARIADB_USER="fhb_crm"
# MARIADB_PASSWORD="your_database_password_here"
# MARIADB_DATABASE="fhb_crm"

